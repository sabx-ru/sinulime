{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sinumerik-core.invalid/schema/topology-v1.schema.json",
  "title": "SINUMERIK Core read-only topology v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "snapshot_id",
    "revision",
    "captured_at",
    "mode",
    "installation_id",
    "completeness",
    "actual",
    "target",
    "reconciliation",
    "evidence",
    "unresolved",
    "extensions"
  ],
  "properties": {
    "schema": {
      "const": "sinumerik-core/read-only-topology/v1"
    },
    "snapshot_id": {
      "$ref": "#/$defs/identifier"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "enum": [
        "live",
        "replay"
      ]
    },
    "installation_id": {
      "$ref": "#/$defs/identifier"
    },
    "completeness": {
      "enum": [
        "complete",
        "partial",
        "failed"
      ]
    },
    "actual": {
      "$ref": "#/$defs/graphOrUnavailable"
    },
    "target": {
      "$ref": "#/$defs/graphOrUnavailable"
    },
    "reconciliation": {
      "$ref": "#/$defs/reconciliation"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unresolved"
      }
    },
    "extensions": {
      "$ref": "#/$defs/jsonObject"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000]+$"
    },
    "status": {
      "enum": [
        "confirmed",
        "reference_only",
        "unresolved",
        "incomplete",
        "not_comparable"
      ]
    },
    "confidence": {
      "enum": [
        "confirmed",
        "probable",
        "unresolved"
      ]
    },
    "jsonValue": {
      "type": [
        "null",
        "boolean",
        "number",
        "string",
        "array",
        "object"
      ],
      "items": {
        "$ref": "#/$defs/jsonValue"
      },
      "additionalProperties": {
        "$ref": "#/$defs/jsonValue"
      }
    },
    "jsonObject": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/jsonValue"
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availability",
        "reason"
      ],
      "properties": {
        "availability": {
          "const": "unavailable"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "graphOrUnavailable": {
      "oneOf": [
        {
          "$ref": "#/$defs/graph"
        },
        {
          "$ref": "#/$defs/availability"
        }
      ]
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objects",
        "channels",
        "ports",
        "connections",
        "relations",
        "extensions"
      ],
      "properties": {
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/domainObject"
          }
        },
        "channels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/channel"
          }
        },
        "ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/port"
          }
        },
        "connections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/connection"
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relation"
          }
        },
        "extensions": {
          "$ref": "#/$defs/jsonObject"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "identity_status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "identity_status": {
          "enum": [
            "stable",
            "provisional",
            "unknown"
          ]
        },
        "source_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "extensions": {
          "$ref": "#/$defs/jsonObject"
        }
      }
    },
    "domainObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "object_kind",
        "status",
        "extensions"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "object_kind": {
          "enum": [
            "physical_device",
            "logical_object",
            "object"
          ]
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "physical_device_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "extensions": {
          "$ref": "#/$defs/jsonObject"
        }
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "owner_id",
        "channel_kind",
        "selector",
        "status",
        "extensions"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "owner_id": {
          "$ref": "#/$defs/identifier"
        },
        "channel_kind": {
          "enum": [
            "axis",
            "feedback",
            "sensor",
            "other"
          ]
        },
        "selector": {
          "$ref": "#/$defs/jsonObject"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "extensions": {
          "$ref": "#/$defs/jsonObject"
        }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "owner_id",
        "port_kind",
        "selector",
        "status",
        "extensions"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "owner_id": {
          "$ref": "#/$defs/identifier"
        },
        "port_kind": {
          "type": "string",
          "minLength": 1
        },
        "selector": {
          "$ref": "#/$defs/jsonObject"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "extensions": {
          "$ref": "#/$defs/jsonObject"
        }
      }
    },
    "endpoint": {
      "oneOf": [
        {
          "$ref": "#/$defs/physicaldeviceEndpoint"
        },
        {
          "$ref": "#/$defs/logicalobjectEndpoint"
        },
        {
          "$ref": "#/$defs/channelEndpoint"
        },
        {
          "$ref": "#/$defs/portEndpoint"
        },
        {
          "$ref": "#/$defs/objectEndpoint"
        }
      ]
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "from",
        "to",
        "status",
        "confidence",
        "rule_id",
        "rule_version",
        "checks",
        "evidence_ids",
        "extensions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "$ref": "#/$defs/endpoint"
        },
        "to": {
          "$ref": "#/$defs/endpoint"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "rule_version": {
          "type": "string",
          "minLength": 1
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "extensions": {
          "$ref": "#/$defs/jsonObject"
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "from",
        "to",
        "status",
        "rule_id",
        "rule_version",
        "checks",
        "evidence_ids",
        "extensions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "const": "representation"
        },
        "from": {
          "$ref": "#/$defs/endpoint"
        },
        "to": {
          "$ref": "#/$defs/endpoint"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "rule_version": {
          "type": "string",
          "minLength": 1
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "extensions": {
          "$ref": "#/$defs/jsonObject"
        }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ref",
        "metadata"
      ],
      "properties": {
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size",
            "format",
            "canonical_relative_path",
            "sha256"
          ],
          "properties": {
            "size": {
              "type": "integer",
              "minimum": 0
            },
            "format": {
              "type": "string",
              "minLength": 1
            },
            "media_type": {
              "type": [
                "string",
                "null"
              ]
            },
            "canonical_relative_path": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^(null|[^/].*)$"
            },
            "sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^([A-Fa-f0-9]{64})?$"
            }
          }
        },
        "source_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "index"
          ],
          "properties": {
            "area": {
              "type": [
                "integer",
                "null"
              ]
            },
            "block": {
              "type": [
                "integer",
                "null"
              ]
            },
            "unit": {
              "type": [
                "integer",
                "null"
              ]
            },
            "param": {
              "type": [
                "integer",
                "string",
                "null"
              ]
            },
            "index": {
              "type": [
                "integer",
                "string"
              ],
              "minimum": 0
            }
          }
        },
        "member": {
          "type": [
            "string",
            "null"
          ]
        },
        "byte_range": {
          "type": [
            "array",
            "null"
          ],
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ],
          "items": false
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "artifact_id",
        "artifact_ref",
        "endpoint_identity",
        "observed_at",
        "quality",
        "rule_id",
        "rule_version",
        "extensions"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/identifier"
        },
        "artifact_id": {
          "$ref": "#/$defs/identifier"
        },
        "artifact_ref": {
          "$ref": "#/$defs/artifactRef"
        },
        "endpoint_identity": {
          "$ref": "#/$defs/endpoint"
        },
        "observed_value": {
          "$ref": "#/$defs/jsonValue"
        },
        "observed_absent": {
          "type": "boolean"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "quality": {
          "enum": [
            "ok",
            "missing",
            "invalid",
            "ambiguous",
            "unreadable"
          ]
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "rule_version": {
          "type": "string",
          "minLength": 1
        },
        "extensions": {
          "$ref": "#/$defs/jsonObject"
        }
      },
      "oneOf": [
        {
          "required": [
            "observed_value"
          ],
          "not": {
            "required": [
              "observed_absent"
            ]
          },
          "properties": {
            "observed_value": {
              "not": {
                "type": "null"
              }
            }
          }
        },
        {
          "required": [
            "observed_absent"
          ],
          "not": {
            "required": [
              "observed_value"
            ]
          },
          "properties": {
            "observed_absent": {
              "const": true
            }
          }
        }
      ]
    },
    "unresolved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "status",
        "extensions"
      ],
      "properties": {
        "reason": {
          "enum": [
            "missing_peer",
            "ambiguous_mapping",
            "selector_mismatch",
            "incomplete_tlv",
            "unreadable",
            "identity_unknown",
            "missing_evidence"
          ]
        },
        "status": {
          "const": "unresolved"
        },
        "candidate_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "extensions": {
          "$ref": "#/$defs/jsonObject"
        }
      }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actual_snapshot_id",
        "target_snapshot_id",
        "status",
        "reason",
        "items",
        "extensions"
      ],
      "properties": {
        "actual_snapshot_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_snapshot_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "same",
            "changed",
            "unresolved",
            "not_comparable"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "change",
              "reason",
              "extensions"
            ],
            "properties": {
              "key": {
                "$ref": "#/$defs/identifier"
              },
              "change": {
                "enum": [
                  "same",
                  "added",
                  "removed",
                  "changed",
                  "unresolved",
                  "not_comparable"
                ]
              },
              "actual_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "target_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "extensions": {
                "$ref": "#/$defs/jsonObject"
              }
            }
          }
        },
        "extensions": {
          "$ref": "#/$defs/jsonObject"
        }
      }
    },
    "physicalDeviceSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_key"
      ],
      "properties": {
        "device_key": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "physicaldeviceEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_id",
        "kind",
        "selector",
        "identity_status"
      ],
      "properties": {
        "object_id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "const": "physical_device"
        },
        "selector": {
          "$ref": "#/$defs/physicalDeviceSelector"
        },
        "identity_status": {
          "enum": [
            "stable",
            "provisional",
            "unknown"
          ]
        }
      }
    },
    "logicalObjectSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_key"
      ],
      "properties": {
        "logical_key": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "logicalobjectEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_id",
        "kind",
        "selector",
        "identity_status"
      ],
      "properties": {
        "object_id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "const": "logical_object"
        },
        "selector": {
          "$ref": "#/$defs/logicalObjectSelector"
        },
        "identity_status": {
          "enum": [
            "stable",
            "provisional",
            "unknown"
          ]
        }
      }
    },
    "channelSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel_kind",
        "ordinal"
      ],
      "properties": {
        "channel_kind": {
          "type": "string",
          "minLength": 1
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "channelEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_id",
        "kind",
        "selector",
        "identity_status"
      ],
      "properties": {
        "object_id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "const": "channel"
        },
        "selector": {
          "$ref": "#/$defs/channelSelector"
        },
        "identity_status": {
          "enum": [
            "stable",
            "provisional",
            "unknown"
          ]
        }
      }
    },
    "portSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group",
        "ordinal"
      ],
      "properties": {
        "group": {
          "type": "integer",
          "minimum": 0
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "portEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_id",
        "kind",
        "selector",
        "identity_status"
      ],
      "properties": {
        "object_id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "const": "port"
        },
        "selector": {
          "$ref": "#/$defs/portSelector"
        },
        "identity_status": {
          "enum": [
            "stable",
            "provisional",
            "unknown"
          ]
        }
      }
    },
    "objectSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_key"
      ],
      "properties": {
        "object_key": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "objectEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_id",
        "kind",
        "selector",
        "identity_status"
      ],
      "properties": {
        "object_id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "const": "object"
        },
        "selector": {
          "$ref": "#/$defs/objectSelector"
        },
        "identity_status": {
          "enum": [
            "stable",
            "provisional",
            "unknown"
          ]
        }
      }
    }
  }
}
