digraph MCVAR_VTABLE_RESOLUTION {
  rankdir=LR; graph [fontname="Helvetica", labelloc=t, label="Phase 11 MCVar vtable resolution"];
  node [shape=box, fontname="Courier"];
  read [label="request/conversion region\n0x10004E2E: call [EDX+4]"];
  vptr [label="vptr loaded from [ESI]\n0x1002C3A0 installation sites"];
  slot [label="vtable +4 = 0x100010D6\nbytes C2 04 00\nret 4"];
  reject [label="NOT transport\nno DDE/API/IPC body"];
  life [label="0x10014CBE lifecycle helper\nlinked [this+4], copy +0x24, vcall +8"];
  unresolved [label="ReadVar downstream object\n0x1000BD47 -> 0x1000C532\nconcrete vptr still unresolved", fillcolor="#fff4d6"];
  read -> vptr [label="mov edx,[esi]"];
  vptr -> slot [label="slot +4; verified bytes"];
  slot -> reject [label="resolved target"];
  life -> reject [label="separate cleanup/lifetime evidence"];
  unresolved -> life [label="not equivalent; do not merge", style=dashed];
  note [shape=note, label="Concrete transport vtable target was not recovered in this pass.\nSymbol labels around StartRequest/StartPoke overlap unreliable boundaries."];
}
