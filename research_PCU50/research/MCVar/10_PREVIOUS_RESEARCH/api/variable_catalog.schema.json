{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/track-d/variable-catalog.schema.json",
  "title": "Track D MCVar/DDE variable catalogue",
  "type": "object",
  "required": ["catalog_version", "scope", "applicability", "confidence_states", "syntax", "signals"],
  "properties": {
    "catalog_version": {"type": "string"},
    "scope": {"type": "string"},
    "generated_at_evidence_session": {"type": "string"},
    "applicability": {"$ref": "#/$defs/applicability"},
    "confidence_states": {"type": "array", "items": {"enum": ["CONFIRMED_READABLE", "OBSERVED_BUT_UNVERIFIED", "DOCUMENTED_NOT_TESTED", "UNSUPPORTED_IN_TEST", "UNKNOWN"]}, "uniqueItems": true},
    "syntax": {"type": "object", "required": ["observed_form", "index_examples", "interpretation_boundary", "address_policy"], "properties": {"observed_form": {"type": "string"}, "index_examples": {"type": "array", "items": {"type": "string"}}, "interpretation_boundary": {"type": "string"}, "address_policy": {"type": "string"}}, "additionalProperties": false},
    "signals": {"type": "array", "items": {"$ref": "#/$defs/signal"}}
  },
  "$defs": {
    "applicability": {"type": "object", "required": ["machine", "target", "mcvar", "dde", "portability"], "properties": {"machine": {"type": "string"}, "target": {"type": "string"}, "mcvar": {"type": "string"}, "dde": {"type": "string"}, "transport_observation": {"type": "string"}, "portability": {"type": "string"}}, "additionalProperties": false},
    "signal": {"type": "object", "required": ["id", "status", "class", "shape", "evidence", "observed"], "properties": {"id": {"type": "string", "pattern": "^/[^\\s]+$"}, "status": {"enum": ["CONFIRMED_READABLE", "OBSERVED_BUT_UNVERIFIED", "DOCUMENTED_NOT_TESTED", "UNSUPPORTED_IN_TEST", "UNKNOWN"]}, "class": {"type": "string"}, "shape": {"enum": ["scalar", "indexed", "unknown"]}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "observed": {"type": "object"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
