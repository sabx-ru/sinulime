digraph COUNTER_STATE_GRAPH {
  rankdir=LR; graph [fontname="Helvetica", labelloc=t, label="NCDDE byte state and runtime replay relation"];
  node [shape=box, fontname="Courier"];
  entry [label="eligible serializer branch\nnot reached on every failed request"];
  read [label="0x44AA8A\nAL := BYTE [0x486884]"];
  arg [label="0x44AA92\nCX := zero_extend(BYTE [ESP+0x20])"];
  pack [label="0x44AAA3\nWORD [0x486BD6] := (old_global<<8)|arg"];
  inc [label="0x44AAB4 / 0x44AAB7\nAL++; BYTE [0x486884] := AL\n8-bit wrap"];
  success [label="later serializer/forward return\nnot a successful-handle guarantee"];
  failures [label="failure branches before/after writer\n0, -1, -2, -3 route-dependent"];
  runtime [label="real corpus replay relation\n198 valid captures; 197 transitions\ndelta = 1 + processed MCVar elements\n0 mismatches", fillcolor="#eef6ff"];
  limit [label="Interpretation boundary\nstatic state write verified; capture model correlated\nno MCVar->writer causality", fillcolor="#fff4d6"];
  entry -> read -> arg -> pack -> inc -> success;
  entry -> failures [label="guard / early error branches"];
  inc -> runtime [style=dashed, label="field-level candidate correlation only"];
  runtime -> limit;
  failures -> limit [style=dashed, label="not every request increments"];
  note [shape=note, label="Old ncdde.exe exact machine-code path; runtime relation independently replayed from preserved logs. No dynamic attribution."];
}
