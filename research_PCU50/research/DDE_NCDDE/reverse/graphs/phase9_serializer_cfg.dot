digraph binary_serializer {
  rankdir=LR;
  node [shape=box, fontname="Helvetica"];
  entry [label="0x44A730\nvalue serializer"];
  select [label="select value + parallel descriptor\n(indexed collections)"];
  meta [label="resolve type/range metadata\n0xFFFFFFFF sentinel\ninclusive range"];
  loop [label="per-element loop\noutput cursor advances"];
  conv [label="provider vtable +0x1C\ntyped conversion"];
  fallback [label="provider vtable +0x18\n-1 fallback"];
  chunk [label="chunk/rebase\n0x1388 (5000) boundary"];
  wrapper [label="0x44AD50\nchoose subobject/branch"];
  add [label="0x44AE23\nhelper 0x466F56\nnew/append data handle"];
  existing [label="0x466FF8\nexisting-handle append"];
  result [label="packet payload +\nheader/length bookkeeping"];
  entry -> select -> meta -> loop;
  loop -> conv [label="element"];
  conv -> fallback [label="return -1"];
  fallback -> loop;
  conv -> chunk [label="bytes / -2,-3"];
  chunk -> loop [label="continue"];
  loop -> wrapper [label="complete"];
  wrapper -> add [label="accumulator null"];
  wrapper -> existing [label="accumulator present"];
  add -> result;
  existing -> result;
  note [shape=note, label="Capture marker F9 F8 F7 F6; +7 is checked as format/state==2.\nIts changing sequence-byte writer is unresolved."];
  result -> note [style=dashed];
}
