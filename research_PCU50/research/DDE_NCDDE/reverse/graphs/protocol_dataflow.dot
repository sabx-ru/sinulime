digraph NCDDE_PROTOCOL_DATAFLOW {
 rankdir=LR; node [shape=box,fontname="Courier"];
 recv [label="old ncdde receiver\n0x448AC0"];
 txn [label="XTYP_REQUEST=0x20B0\n0x449175 -> 0x449265"];
 fmt [label="format dispatch\nCF_TEXT/configured/binary paths\nOEM=7 special comparison"];
 item [label="item/producer resolution\n0x4493D4 -> 0x44A440"];
 init [label="binary header init\n0x44A5A1\nWORD 20, version 1, marker"];
 ser [label="worker serializer\n0x44A730\nloops/typed output; full dictionary open"];
 counter [label="0x44AA8A read global\n0x44AAA3 packed store\n0x44AAB4..B7 increment"];
 forward [label="0x44AD50 forwarding"];
 handle [label="0x44AE23\nDdeCreateDataHandle ABI verified"];
 text [label="CF_TEXT output\ntext capture evidence; backend comparison open"];
 oem [label="CF_OEMTEXT item equality\nsource Ncdde\\0, cb=6"];
 recv -> txn -> fmt;
