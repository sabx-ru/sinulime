digraph ncdde_response_counter {
  rankdir=TB; node [shape=box,fontname="monospace"];
  recv [label="0x448AC0 receiver\ntransaction dispatch"];
  txn [label="0x449175..1A\nsub 0x20B0; JE 0x449265"];
  fmt [label="0x449265..2C7\nwFmt=[EBP+0x0C]\n1 / configured WORD@0x499950 / 7 / other"];
  fmt7 [label="format 7\ncompare current item [0x486864]\nwith [0x4A6D18] via DdeCmpStringHandles"];
  fmt7fail [label="nonzero compare\nbranch 0x449A53; reject/cleanup"];
  fmt7ok [label="equal\nDdeCreateDataHandle\ncb=6; pSrc=0x479C64\n'Ncdde\\0'"];
  normal [label="other supported format\nitem/request resolution"];
  producer [label="0x4493D4 -> thunk 0x4021AD\n-> producer 0x44A440"];
  init [label="0x44A5A1 serializer\ninitialize header/buffer when needed"];
  worker [label="0x44A730\nresolve indexed item + encode/iterate"];
  seq [label="eligible sequence path\n0x44AA8A..B7: combine stack byte + global byte\nWORD [0x486BD6]; increment BYTE [0x486884]"];
  errors [label="worker return checks\n-3 or 0 -> failure 0x44AB67/0\n-2 -> 0x44ABC8/0xFFFFFFFE\n-1: special handling, may reject at 0x44AB67"];
  flush [label="0x44A66E / 0x44AB2B\nforward buffer through thunk\n0x4012F8 -> 0x44AD50"];
  create [label="0x44AE23 -> 0x466F56\nIAT 0x006C6338\nDdeCreateDataHandle"];
  add [label="existing handle paths\n0x44ADDE / 0x44AE5C\nDdeAddData; distinct from create"];
  recv -> txn -> fmt;
  fmt -> fmt7 [label="wFmt==7"]; fmt7 -> fmt7fail [label="not item match"];
  fmt7 -> fmt7ok [label="match"];
  fmt -> normal [label="non-7 cases"];
  normal -> producer -> init -> worker;
  worker -> seq [label="gated success/sequence path"];
  worker -> errors [label="failure sentinels"];
  worker -> flush [label="buffer output path"];
  flush -> create [label="new data handle path"];
  flush -> add [label="existing data handle path"];
  fmt7ok -> create;
}
