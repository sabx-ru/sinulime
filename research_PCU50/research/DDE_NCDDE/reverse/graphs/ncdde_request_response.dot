digraph NCDDE_SERVER_DATAFLOW {
  rankdir=LR; graph [fontname="Helvetica", labelloc=t, label="Old ncdde.exe server response dataflow; VA base 0x400000"];
  node [shape=box, fontname="Courier"];
  recv [label="receiver 0x448AC0"];
  txn [label="0x449175: cmp transaction 0x20B0\nJE 0x449265"];
  fmt [label="0x449265\nwFmt=[EBP+0x0C]\nformat gates incl. 1 / configured / 7"];
  item [label="item equality / item request routing\ncurrent handle [0x486864]"];
  special [label="format 7 + item equal\nDdeCreateDataHandle\ncb=6, source 0x479C64 'Ncdde\\0'"];
  producer [label="0x4493D4 -> thunk 0x4021AD -> 0x44A440"];
  init [label="0x44A5A1\nheader init: WORD 20, WORD 1\nmarker at +0x10"];
  worker [label="0x44A730\nindexed item resolution / encode loop"];
  error [label="worker results\n0, -1, -2, -3 have gated outcomes\nnot all continue"];
  seq [label="0x44AA8A..0x44AAB7\nword [0x486BD6]=(stack_byte<<8)|old_global_byte\nthen global byte++ modulo 256"];
  flush [label="0x44A66E / 0x44AB2B\nforward pointer/length via thunk 0x4012F8"];
  wrapper [label="0x44AD50\nmode/handle/format gates"];
  create [label="0x44AE23 -> USER32 DdeCreateDataHandle\n7 args reverse-push verified"];
  add [label="existing handle route\nDdeAddData paths 0x44ADDE / 0x44AE5C"];
  reject [label="reject / cleanup\nincluding OEM mismatch branch 0x449A53"];
  recv -> txn -> fmt;
  fmt -> item [label="supported normal format"];
  fmt -> special [label="wFmt==7 and item equal"];
  fmt -> reject [label="global/format gate failure"];
  item -> producer [label="guarded request route; callsite 0x4493D4"];
  item -> reject [label="item/producer failure"];
  producer -> init -> worker;
  worker -> error [label="negative/error sentinels"];
  worker -> seq [label="eligible guarded path only"];
  worker -> flush [label="output/flush path"];
  seq -> flush [label="buffer state"];
  flush -> wrapper;
  wrapper -> create [label="new handle path"];
  wrapper -> add [label="existing handle path"];
  special -> create;
  note [shape=note, label="Static old-image proof. Does not attribute all real captures to these paths or join MCVar invocation causally."];
}
